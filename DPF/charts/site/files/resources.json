  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "dpf-install-checks",
      "namespace": "dpf-operator-system",
      "annotations": {
        "argocd.argoproj.io/sync-wave": "60"
      }
    }
  },
  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "name": "dpf-wait-operator",
      "namespace": "dpf-operator-system",
      "annotations": {
        "argocd.argoproj.io/sync-wave": "65",
        "argocd.argoproj.io/hook": "Sync",
        "argocd.argoproj.io/hook-delete-policy": "BeforeHookCreation"
      }
    },
    "spec": {
      "backoffLimit": 0,
      "activeDeadlineSeconds": 1300,
      "template": {
        "spec": {
          "serviceAccountName": "dpf-install-checks",
          "restartPolicy": "Never",
          "tolerations": [
            {
              "key": "node-role.kubernetes.io/control-plane",
              "operator": "Exists",
              "effect": "NoSchedule"
            },
            {
              "key": "node-role.kubernetes.io/master",
              "operator": "Exists",
              "effect": "NoSchedule"
            }
          ],
          "containers": [
            {
              "name": "check",
              "image": "clastix/kubectl:v1.34",
              "command": [
                "/bin/sh",
                "-ec",
                "kubectl wait -n dpf-operator-system dpfoperatorconfig/dpfoperatorconfig --for=condition=SystemComponentsReconciled --timeout=600s\n"
              ]
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "operator.dpu.nvidia.com/v1alpha1",
    "kind": "DPFOperatorConfig",
    "metadata": {
      "name": "dpfoperatorconfig",
      "namespace": "dpf-operator-system",
      "annotations": {
        "argocd.argoproj.io/sync-wave": "60"
      }
    },
    "spec": {
      "dpuDetector": {
        "disable": true
      },
      "kamajiClusterManager": {
        "disable": false,
        "replicas": 2
      },
      "networking": {
        "controlPlaneMTU": 1500,
        "highSpeedMTU": 1500
      },
      "overrides": {
        "kubernetesAPIServerPort": 6443,
        "kubernetesAPIServerVIP": "198.51.100.20",
        "argoCDNamespace": "dpf-operator-system"
      },
      "provisioningController": {
        "dmsTimeout": 900,
        "installInterface": {
          "installViaRedfish": {
            "skipDPUNodeDiscovery": false
          }
        },
        "maxDPUParallelInstallations": 50,
        "maxUnavailableDPUNodes": 50,
        "multiDPUOperationsSyncWaitTime": "30s",
        "nodeEffectRemovalTimeout": "0s",
        "osInstallTimeout": "45m",
        "replicas": 2
      }
    }
  },
  {
