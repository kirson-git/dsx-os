{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiServerIP",
    "vipInterface",
    "europeVIP",
    "asiaVIP",
    "apiServerPort"
  ],
  "properties": {
    "apiServerIP": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
      "description": "Existing management Kubernetes API IPv4 endpoint"
    },
    "europeVIP": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
      "description": "Reserved Europe tenant API IPv4 VIP"
    },
    "asiaVIP": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
      "description": "Reserved Asia tenant API IPv4 VIP"
    },
    "vipInterface": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$"
    },
    "apiServerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "install-dhcp": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no"
    },
    "dhcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeName",
        "interface",
        "serverIP",
        "subnet",
        "netmask",
        "gateway",
        "reservations"
      ],
      "properties": {
        "nodeName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "interface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$"
        },
        "serverIP": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "subnet": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "netmask": {
          "type": "string",
          "enum": [
            "255.0.0.0",
            "255.128.0.0",
            "255.192.0.0",
            "255.224.0.0",
            "255.240.0.0",
            "255.248.0.0",
            "255.252.0.0",
            "255.254.0.0",
            "255.255.0.0",
            "255.255.128.0",
            "255.255.192.0",
            "255.255.224.0",
            "255.255.240.0",
            "255.255.248.0",
            "255.255.252.0",
            "255.255.254.0",
            "255.255.255.0",
            "255.255.255.128",
            "255.255.255.192",
            "255.255.255.224",
            "255.255.255.240",
            "255.255.255.248",
            "255.255.255.252"
          ]
        },
        "gateway": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "dnsServers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
          }
        },
        "reservations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "mac",
              "ip"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "mac": {
                "type": "string",
                "pattern": "^$|^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"
              },
              "ip": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              },
              "gateway": {
                "type": "boolean"
              },
              "netmask": {
                "type": "string",
                "enum": [
                  "255.0.0.0",
                  "255.128.0.0",
                  "255.192.0.0",
                  "255.224.0.0",
                  "255.240.0.0",
                  "255.248.0.0",
                  "255.252.0.0",
                  "255.254.0.0",
                  "255.255.0.0",
                  "255.255.128.0",
                  "255.255.192.0",
                  "255.255.224.0",
                  "255.255.240.0",
                  "255.255.248.0",
                  "255.255.252.0",
                  "255.255.254.0",
                  "255.255.255.0",
                  "255.255.255.128",
                  "255.255.255.192",
                  "255.255.255.224",
                  "255.255.255.240",
                  "255.255.255.248",
                  "255.255.255.252"
                ]
              }
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "dpuNode",
              "idracIP",
              "serial",
              "managementNode",
              "verifyTLS"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "europe",
                  "asia"
                ]
              },
              "dpuNode": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
                "maxLength": 63
              },
              "idracIP": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              },
              "serial": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$",
                "maxLength": 64
              },
              "managementNode": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
                "maxLength": 63
              },
              "verifyTLS": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "install-dhcp": {
            "const": "yes"
          }
        },
        "required": [
          "install-dhcp"
        ]
      },
      "then": {
        "required": [
          "dhcp"
        ]
      }
    }
  ]
}
