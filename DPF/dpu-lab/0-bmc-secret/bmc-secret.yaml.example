# The password DPF uses to log in to the BMC of every DPU.
# This example file is safe to keep in Git: it holds no real password.
# Run from the DPF folder:
#
#   cp dpu-lab/0-bmc-secret/bmc-secret.yaml.example dpu-lab/0-bmc-secret/bmc-secret.yaml
#   chmod 600 dpu-lab/0-bmc-secret/bmc-secret.yaml
#   (edit bmc-secret.yaml: put your password between the quotes)
#   kubectl apply -f dpu-lab/0-bmc-secret/
#   curl -sk --user root https://<DPU BMC address>/redfish/v1/Systems/Bluefield | grep -oE '"(SerialNumber|PartNumber)": *"[^"]*"'   # proves the password works
#
# bmc-secret.yaml is ignored by Git. Never commit a file with a real password.
apiVersion: v1
kind: Secret
metadata:
  name: bmc-shared-password
  namespace: dpf-operator-system
type: Opaque
stringData:
  password: "YOUR_BMC_PASSWORD"  # please change here: root password of the DPU BMC; keep the quotes
